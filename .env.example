# Copy to .env for local development. Never commit real credentials.

# Optional Google visualisation. Required only when the frontend enables
# Google Maps / 3D Map Tiles; not needed for the backend's 200 m risk grid.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Optional authoritative cyclone forecast provider. Leave blank while the
# key-free demo provider is used.
CYCLONE_FORECAST_API_KEY=
CYCLONE_FORECAST_BASE_URL=

# Optional database. Required when scenarios must survive service restarts.
DATABASE_URL=

# Comma-separated frontend origins allowed to call this API in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Model safeguards. Keep the first release fixed to normal wind incidence.
GRID_SIZE_M=200
WIND_INCIDENCE_ANGLE_DEG=90
